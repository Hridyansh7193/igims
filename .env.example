# ==============================================================================
# IGIMS CEREBREXIA '26 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in the Vercel Project Settings (Settings -> Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC CONFIGURATION (Exposed to browser via Vite bundle)
# ------------------------------------------------------------------------------
# In Production: Use production Supabase URL and anon key.
# In Preview:    Use staging Supabase URL and anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Razorpay Key ID (Public Identifier)
# In Production: MUST start with rzp_live_
# In Preview:    MUST start with rzp_test_ (Live keys are blocked in Preview)
VITE_RAZORPAY_KEY_ID=rzp_test_your_test_key_id

# Optional: Custom Hosted Payment Page URL
VITE_RAZORPAY_PAYMENT_LINK=

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER expose to frontend; NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
# Supabase Server Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Razorpay Server Configuration
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin Portal Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_JWT_SECRET=your_admin_jwt_secret_salt

# Booking Portal Authentication
BOOKING_PORTAL_USERNAME=booking_desk
BOOKING_PORTAL_PASSWORD=your_secure_portal_password
BOOKING_PORTAL_JWT_SECRET=your_portal_jwt_secret_salt

# Gate Scanner Authentication (APK-only)
GATE_SCANNER_PASSWORD=your_gate_scanner_password
GATE_SCANNER_JWT_SECRET=your_gate_scanner_jwt_secret
GATE_SCANNER_USERNAME_1=gate1
GATE_SCANNER_PASSWORD_1=your_gate1_password
GATE_SCANNER_USERNAME_2=gate2
GATE_SCANNER_PASSWORD_2=your_gate2_password
# Optional terminal header secret (only enforced if configured)
GATE_SECRET_KEY=

# Email Dispatch Configuration (Gmail SMTP)
# In Preview: Emails are suppressed by default unless EMAIL_ENABLED=true
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_COPY_EMAIL=
GMAIL_ARCHIVE_EMAIL=
CONTACT_INBOX_EMAIL=cerebrexia26igims@gmail.com
REMINDER_FROM=
APP_URL=https://www.cerebrexiaigims.com

# Google Sheets Synchronization (Apps Script Webhook)
# In Preview: Sheets sync is disabled by default unless GOOGLE_SHEETS_SYNC_ENABLED=true
GOOGLE_SHEETS_WEBHOOK_URL=

# Cron Job Secret (for /api/send-reminders)
CRON_SECRET=your_long_random_cron_secret

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT ISOLATION FEATURE FLAGS
# ------------------------------------------------------------------------------
# In Preview deployments, set these explicitly to control external services:
EMAIL_ENABLED=false
GOOGLE_SHEETS_SYNC_ENABLED=false
PAYMENTS_ENABLED=false
